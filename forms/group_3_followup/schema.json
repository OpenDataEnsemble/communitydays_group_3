{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "title": "Session topic",
      "minLength": 1,
      "maxLength": 240
    },
    "attendance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "title": "Number attending"
    },
    "understanding": {
      "type": "string",
      "enum": [
        "Getting started",
        "Making progress",
        "Confident"
      ],
      "title": "Group understanding"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "entity_id",
    "topic",
    "attendance",
    "understanding"
  ]
}
