{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Club name",
      "minLength": 1,
      "maxLength": 240
    },
    "subject": {
      "type": "string",
      "title": "Main subject",
      "minLength": 1,
      "maxLength": 240
    },
    "venue": {
      "type": "string",
      "title": "Meeting venue",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "title": "Short description",
      "maxLength": 120
    }
  },
  "required": [
    "name",
    "subject",
    "venue"
  ]
}
